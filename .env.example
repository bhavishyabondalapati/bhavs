# Copy to .env and fill in. Never commit .env. Placeholders only here.
AWS_PROFILE=sky
AWS_REGION=us-east-2
# Receives AWS Budget alerts and CloudWatch alarm emails (confirm the SNS subscription email once).
BUDGET_ALERT_EMAIL=you@example.com
# A TEST account in your own Cognito user pool, used by `make e2e-journey` and `make loadtest`.
E2E_EMAIL=e2e@example.test
E2E_PASSWORD=change-me
# An admin TEST account (member of the Cognito "admin" group) for the analytics page.
E2E_ADMIN_EMAIL=admin-e2e@example.test
E2E_ADMIN_PASSWORD=change-me
